<Window x:Class="PaolaScreenStudio.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PaolaScreenStudio"
        Width="1400" Height="900" MinWidth="1000" MinHeight="640"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" Icon="Assets/AppIcon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Top bar -->
        <DockPanel Grid.ColumnSpan="2" Margin="16,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="UndoButton" Click="Undo_Click" Padding="10,5">↶</Button>
                <Button x:Name="RedoButton" Click="Redo_Click" Padding="10,5" Margin="6,0,0,0">↷</Button>
                <Button x:Name="ExportButton" Style="{StaticResource Primary}" Margin="12,0,0,0" Padding="16,6" Click="Export_Click"/>
            </StackPanel>
            <Image Source="Assets/Logo.png" Width="26" Height="26"/>
            <TextBlock x:Name="TitleText" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock x:Name="SavedText" Margin="10,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Preview -->
        <Border Grid.Row="1" Margin="16,0,8,8" Background="#000000" CornerRadius="10" ClipToBounds="True">
            <Viewbox Stretch="Uniform" Margin="0">
                <Canvas x:Name="Stage">
                    <Rectangle x:Name="BackgroundRect"/>
                    <Border x:Name="ShadowBox" Background="Black">
                        <Border.Effect>
                            <DropShadowEffect x:Name="Shadow" BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.5"/>
                        </Border.Effect>
                    </Border>
                    <Border x:Name="ContentBox" ClipToBounds="True" Background="Black">
                        <Canvas x:Name="ZoomCanvas">
                            <MediaElement x:Name="ScreenPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True" Stretch="Fill"/>
                        </Canvas>
                    </Border>
                    <Grid x:Name="CameraBox">
                        <Border x:Name="CameraClip" Background="#18181C" ClipToBounds="True">
                            <MediaElement x:Name="CameraPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True"
                                          Stretch="UniformToFill" IsMuted="True" RenderTransformOrigin="0.5,0.5"/>
                        </Border>
                        <Border x:Name="CameraRing" IsHitTestVisible="False"/>
                    </Grid>
                </Canvas>
            </Viewbox>
        </Border>

        <!-- Inspector -->
        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Margin="8,0,16,16" Background="{StaticResource Panel}" CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Inspector" Margin="16"/>
            </ScrollViewer>
        </Border>

        <!-- Transport -->
        <DockPanel Grid.Row="2" Margin="16,0,8,6">
            <Button x:Name="PlayButton" Width="44" Click="Play_Click" FontSize="14">▶</Button>
            <TextBlock x:Name="TimeText" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddZoomButton" Click="AddZoom_Click"/>
                <Button x:Name="AddCutButton" Margin="6,0,0,0" Click="AddCut_Click"/>
                <Button x:Name="TrimStartButton" Margin="6,0,0,0" Click="TrimStart_Click"/>
                <Button x:Name="TrimEndButton" Margin="6,0,0,0" Click="TrimEnd_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Timeline -->
        <Border Grid.Row="3" Margin="16,0,8,16" Background="{StaticResource Panel}" CornerRadius="12" Padding="0,8">
            <local:TimelineControl x:Name="Timeline"/>
        </Border>
    </Grid>
</Window>
