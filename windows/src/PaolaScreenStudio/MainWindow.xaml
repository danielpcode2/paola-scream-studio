<Window x:Class="PaolaScreenStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paola Screen Studio" Width="900" Height="640" MinWidth="760" MinHeight="520"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,16">
            <Image Source="Assets/Logo.png" Width="44" Height="44" DockPanel.Dock="Left"/>
            <StackPanel DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Paola Screen Studio" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox x:Name="LanguageBox" Width="110" SelectionChanged="LanguageChanged_"/>
                <Button x:Name="SettingsButton" Margin="8,0,0,0" Click="Settings_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Record -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="WhatLabel" Style="{StaticResource Section}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModeDisplay" GroupName="mode" Checked="Mode_Changed"/>
                        <RadioButton x:Name="ModeWindow" GroupName="mode" Checked="Mode_Changed"/>
                        <RadioButton x:Name="ModeArea" GroupName="mode" Checked="Mode_Changed"/>
                    </StackPanel>
                    <ComboBox x:Name="DisplayBox" Margin="0,10,0,0"/>
                    <DockPanel x:Name="WindowPanel" Margin="0,10,0,0">
                        <Button x:Name="RefreshWindows" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2" Click="RefreshWindows_Click">⟳</Button>
                        <ComboBox x:Name="WindowBox"/>
                    </DockPanel>
                    <DockPanel x:Name="AreaPanel" Margin="0,10,0,0">
                        <Button x:Name="SelectAreaButton" DockPanel.Dock="Left" Click="SelectArea_Click"/>
                        <TextBlock x:Name="AreaLabel" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                    </DockPanel>

                    <TextBlock x:Name="CameraLabel" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="CameraBox"/>
                    <TextBlock x:Name="MicLabel" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="MicBox"/>
                    <CheckBox x:Name="SystemAudioBox" Margin="0,12,0,0"/>

                    <TextBlock x:Name="CountdownLabel" Style="{StaticResource Section}"/>
                    <ComboBox x:Name="CountdownBox" Width="120" HorizontalAlignment="Left"/>

                    <Button x:Name="RecordButton" Style="{StaticResource Primary}" Margin="0,22,0,0" Click="Record_Click"/>
                    <TextBlock x:Name="HotkeysHint" Margin="0,10,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11"/>
                    <TextBlock x:Name="FfmpegWarning" Margin="0,10,0,0" Foreground="#FFB4B4" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Projects -->
        <Border Grid.Row="1" Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="18">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="ProjectsLabel" Style="{StaticResource Section}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenFolderButton" Padding="8,3" Click="OpenFolder_Click"/>
                        <Button x:Name="RefreshProjects" Padding="8,3" Margin="6,0,0,0" Click="RefreshProjects_Click">⟳</Button>
                    </StackPanel>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="OpenProjectButton" Click="OpenProject_Click"/>
                    <Button x:Name="ShowProjectButton" Margin="8,0,0,0" Click="ShowProject_Click"/>
                    <Button x:Name="DeleteProjectButton" Margin="8,0,0,0" Click="DeleteProject_Click"/>
                </StackPanel>
                <ListBox x:Name="ProjectList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}"
                         MouseDoubleClick="OpenProject_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
